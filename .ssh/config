# Reuse a single SSH connection for repeated operations against the same
# host. With multiplexing the first connection pays that cost and subsequent
# ones reuse it, staying open for ControlPersist afterwards.
#
# ControlPath uses %C (a hash of user/host/port) to keep the socket path
# short - unix sockets are capped near 104 characters on macOS.
Host *
    ControlMaster auto
    ControlPath ~/.ssh/control-%C
    ControlPersist 5m
