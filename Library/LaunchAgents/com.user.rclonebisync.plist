<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.rclonebisync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/rclone</string>
        <string>bisync</string>
        <string>/Users/br.athanasius/Documents</string>
        <string>gdrive:Documents</string>
        <string>--filters-file</string>
        <string>/Users/br.athanasius/.config/rclone/doc-filters.txt</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/rclone-bisync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/rclone-bisync-error.log</string>
</dict>
</plist>
